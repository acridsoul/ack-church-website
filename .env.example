# Environment variables for the /ask chatbot.
#
# Copy to `.env` for local work. On Vercel, set these in
# Project -> Settings -> Environment Variables.

# --- Server-side only (used by api/chat.ts) ---------------------------------
#
# NEVER prefix these with VITE_. Vite inlines every VITE_* variable into the
# browser bundle, so a VITE_LLM_API_KEY would hand your key to every visitor.

# Required. The key for your LLM provider. Without it, /api/chat returns 503 and
# the site falls back to answering from the archive alone.
LLM_API_KEY=

# Any OpenAI-compatible chat-completions endpoint. This one setting covers
# OpenAI, OpenRouter, Groq, Together, DeepSeek, and Gemini's OpenAI-compatible
# endpoint. Anthropic's native API is not OpenAI-shaped and needs an adapter.
#
# Worked example — DeepSeek:
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-flash
# DeepSeek's current models are `deepseek-flash` and `deepseek-v4-pro`. The older
# `deepseek-chat` / `deepseek-reasoner` names are retired legacy aliases pointing
# at a retired model. `deepseek-flash` is the right choice here: answers are two
# to four sentences drawn from extracts already in the prompt.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Thinking / reasoning mode. `auto` (the default) disables it for DeepSeek and
# sends nothing to other providers.
#
# This matters: DeepSeek enables thinking mode by default, and its reasoning
# tokens count against max_tokens. With the short answer budget here the
# reasoning would consume the whole allowance and return empty content, so every
# question would fail. Set `enabled` or `disabled` only to override.
LLM_THINKING=auto

# Comma-separated list of origins allowed to call the function from a different
# site. Leave empty when the site and the API are the same Vercel deployment —
# an empty value means "same origin only", which is the safe default.
ALLOWED_ORIGINS=

# Abuse guards. Rate limiting is best-effort and per serverless instance; a
# durable limit would need Vercel KV or Upstash.
CHAT_RATE_LIMIT=12
CHAT_MAX_QUESTION_CHARS=500

# --- Client-side (build-time, public) ---------------------------------------
#
# Only needed when the API is on a different origin from the site, e.g. the
# frontend published from Lovable and the function on Vercel.
# VITE_CHAT_API_URL=https://your-api.vercel.app/api/chat
